X-Content-Type-Options: nosniff
X-Frame-Options: DENY
Referrer-Policy: same-origin
Permissions-Policy: camera=(), microphone=(), geolocation=()
# Trystero (P2P signaling) is pinned to a small relay subset in
# index.html (RELAY_URLS, currently 4 public Nostr relays).
# connect-src keeps 'self' + a wildcard wss: for those relay WebSockets:
# - nostr nips-02 signaling: wss://<host>
# - CDN: trystero bundle + the +esm re-export shim
Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://esm.run; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' wss: https://cdn.jsdelivr.net https://esm.run; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
